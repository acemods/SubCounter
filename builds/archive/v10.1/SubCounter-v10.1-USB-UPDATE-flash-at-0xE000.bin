const last=s.pts[s.pts.length-1];ends.push({s,y:Y(last[1]),v:last[1]})});
ends.sort((a,b)=>a.y-b.y);for(let k=1;k<ends.length;k++)if(ends[k].y-ends[k-1].y<16)ends[k].y=ends[k-1].y+16;
